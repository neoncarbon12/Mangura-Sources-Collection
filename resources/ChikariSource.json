{
	"id": "chikari",
	"name": "chikari.moe",
	"version": 1,
	"logo": "https://chikari.moe/apple-touch-icon.png",
	"base_url": "https://chikari.moe/",
	"catalog": {
		"default_parser": {
			"response_type": "json",
			"results": {
				"type": "node",
				"key": "items",
				"for_each": {
					"manga_id": { "key": "slug" },
					"manga_title": { "key": "title" },
					"manga_cover": {
						"type": "url",
						"key": "cover_url",
						"headers": { "Referer": "{base_url}" }
					}
				}
			}
		},
		"trending": {
			"request": {
				"request_type": "json_request",
				"type": "relative",
				"base": "api/series",
				"method": "GET",
				"query_parameters": [
					{ "name": "sort", "value": "trending" },
					{ "name": "limit", "value": "24" },
					{ "name": "offset", "value": "{page}", "rules": ["multiplyBy(24)"] }
				],
				"headers": { "Referer": "{base_url}" }
			}
		},
		"newest": {
			"request": {
				"request_type": "json_request",
				"type": "relative",
				"base": "api/series",
				"method": "GET",
				"query_parameters": [
					{ "name": "sort", "value": "updated" },
					{ "name": "limit", "value": "24" },
					{ "name": "offset", "value": "{page}", "rules": ["multiplyBy(24)"] }
				],
				"headers": { "Referer": "{base_url}" }
			}
		},
		"search": {
			"request": {
				"request_type": "json_request",
				"type": "relative",
				"base": "api/series",
				"method": "GET",
				"query_parameters": [
					{ "name": "q", "value": "{query}", "rules": ["forceNonEmpty"] },
					{ "name": "sort", "value": "popular" },
					{ "name": "limit", "value": "24" },
					{ "name": "offset", "value": "{page}", "rules": ["multiplyBy(24)"] }
				],
				"headers": { "Referer": "{base_url}" }
			},
			"filters": []
		}
	},
	"details": {
		"request": {
			"request_type": "json_request",
			"type": "relative",
			"base": "api/series",
			"method": "GET",
			"path_parameters": [{ "value": "{manga_id}", "rules": ["forceNonEmpty"] }],
			"headers": { "Referer": "{base_url}" }
		},
		"parser": {
			"response_type": "json",
			"manga_title": { "key": "title" },
			"manga_description": {
				"key": "description",
				"ops": [{ "type": "trim" }]
			},
			"manga_status": { "key": "status" },
			"manga_authors": {
				"type": "list",
				"key": "slug",
				"ops": [
					{ "type": "regex_replace", "pattern": "[\\s\\S]*", "value": "" },
					{ "type": "split", "pattern": "," }
				]
			},
			"manga_tags": {
				"type": "list",
				"key": "slug",
				"ops": [
					{ "type": "regex_replace", "pattern": "[\\s\\S]*", "value": "" },
					{ "type": "split", "pattern": "," }
				]
			},
			"manga_cover": {
				"type": "url",
				"key": "cover_url",
				"headers": { "Referer": "{base_url}" }
			},
			"manga_url": {
				"type": "url",
				"key": "slug",
				"ops": [{ "type": "prepend_if_missing", "value": "https://chikari.moe/series/" }]
			}
		}
	},
	"chapters": {
		"request": {
			"request_type": "json_request",
			"type": "relative",
			"base": "api/series",
			"method": "GET",
			"path_parameters": [
				{ "value": "{manga_id}", "rules": ["forceNonEmpty"] },
				{ "value": "chapters" }
			],
			"query_parameters": [{ "name": "limit", "value": "200" }],
			"headers": { "Referer": "{base_url}" }
		},
		"parser": {
			"response_type": "json",
			"chapters": {
				"type": "node",
				"key": "items",
				"for_each": {
					"chapter_id": { "key": "number" },
					"chapter_url": {
						"type": "url",
						"key": "number",
						"ops": [{ "type": "as_path_parameter", "pattern": "{chapters_url}" }]
					},
					"chapter_number": { "type": "double", "key": "number" },
					"chapter_title": { "key": "title" },
					"chapter_uploaded_at": {
						"type": "date",
						"key": "created_at",
						"format": "yyyy-MM-dd'T'HH:mm:ssZZZZZ",
						"ops": [{ "type": "regex_replace", "pattern": "\\.\\d+", "value": "" }]
					}
				}
			}
		}
	},
	"pages": {
		"request": {
			"request_type": "json_request",
			"type": "placeholder",
			"base": "chapter_url",
			"method": "GET",
			"headers": { "Referer": "{base_url}" }
		},
		"parser": {
			"response_type": "json",
			"pages": { "type": "list", "key": "pages" }
		}
	},
	"mapping": {
		"manga_status": {
			"releasing": "ongoing",
			"completed": "completed",
			"hiatus": "hiatus",
			"cancelled": "cancelled"
		}
	}
}
