{
	"id": "mangafire",
	"name": "MangaFire",
	"version": 2,
	"logo": "https://neoncarbon12.github.io/Mangura-Sources-Collection/resources/icons/mangafire.png",
	"base_url": "https://mangafire.to/",
	"catalog": {
		"default_parser": {
			"response_type": "json",
			"results": {
				"type": "node",
				"key": "items",
				"for_each": {
					"manga_id": { "key": "hid" },
					"manga_title": { "key": "title" },
					"manga_cover": {
						"type": "url",
						"key": "poster.medium",
						"headers": { "Referer": "{base_url}" }
					}
				}
			}
		},
		"trending": {
			"request": {
				"request_type": "request_capture",
				"type": "relative",
				"base": "browse",
				"method": "GET",
				"query_parameters": [
					{ "name": "sort", "value": "views_7d:desc" },
					{ "name": "page", "value": "{page}", "rules": ["startsAtOne"] }
				],
				"headers": { "Referer": "{base_url}" },
				"capture_patterns": ["/api/titles?"],
				"on_capture": {
					"request_type": "json_request",
					"type": "placeholder",
					"base": "captured_url",
					"method": "GET",
					"headers": { "Referer": "{base_url}" }
				}
			}
		},
		"newest": {
			"request": {
				"request_type": "request_capture",
				"type": "relative",
				"base": "browse",
				"method": "GET",
				"query_parameters": [
					{ "name": "sort", "value": "chapter_updated_at:desc" },
					{ "name": "page", "value": "{page}", "rules": ["startsAtOne"] }
				],
				"headers": { "Referer": "{base_url}" },
				"capture_patterns": ["/api/titles?"],
				"on_capture": {
					"request_type": "json_request",
					"type": "placeholder",
					"base": "captured_url",
					"method": "GET",
					"headers": { "Referer": "{base_url}" }
				}
			}
		},
		"search": {
			"request": {
				"request_type": "request_capture",
				"type": "relative",
				"base": "browse",
				"method": "GET",
				"query_parameters": [
					{ "name": "keyword", "value": "{query}", "rules": ["forceNonEmpty"] },
					{ "name": "page", "value": "{page}", "rules": ["startsAtOne"] }
				],
				"headers": { "Referer": "{base_url}" },
				"capture_patterns": ["/api/titles?"],
				"on_capture": {
					"request_type": "json_request",
					"type": "placeholder",
					"base": "captured_url",
					"method": "GET",
					"headers": { "Referer": "{base_url}" }
				}
			}
		}
	},
	"details": {
		"request": {
			"request_type": "request_capture",
			"type": "relative",
			"base": "title",
			"method": "GET",
			"path_parameters": [{ "value": "{manga_id}", "rules": ["forceNonEmpty"] }],
			"headers": { "Referer": "{base_url}" },
			"capture_patterns": ["/api/titles/"],
			"on_capture": {
				"request_type": "json_request",
				"type": "placeholder",
				"base": "captured_url",
				"method": "GET",
				"headers": { "Referer": "{base_url}" }
			}
		},
		"parser": {
			"response_type": "json",
			"manga_id": { "key": "data.hid" },
			"manga_title": { "key": "data.title" },
			"manga_cover": {
				"type": "url",
				"key": "data.poster.large",
				"headers": { "Referer": "{base_url}" }
			},
			"manga_description": {
				"key": "data.synopsisHtml",
				"ops": [
					{ "type": "regex_replace", "pattern": "<br\\s*/?>", "value": "\n" },
					{ "type": "regex_replace", "pattern": "<[^>]+>", "value": "" },
					{ "type": "replace", "pattern": "&#039;", "value": "'" },
					{ "type": "replace", "pattern": "&quot;", "value": "\"" },
					{ "type": "replace", "pattern": "&lt;", "value": "<" },
					{ "type": "replace", "pattern": "&gt;", "value": ">" },
					{ "type": "replace", "pattern": "&amp;", "value": "&" },
					{ "type": "trim" }
				]
			},
			"manga_status": { "key": "data.status" },
			"manga_authors": {
				"type": "list",
				"key": "data.authors.[0].title",
				"ops": [{ "type": "split", "pattern": "\n" }]
			},
			"manga_tags": {
				"type": "list",
				"key": "data.genres.[0].title",
				"ops": [{ "type": "split", "pattern": "\n" }]
			}
		}
	},
	"chapters": {
		"request": {
			"request_type": "request_capture",
			"type": "relative",
			"base": "title",
			"method": "GET",
			"path_parameters": [{ "value": "{manga_id}", "rules": ["forceNonEmpty"] }],
			"headers": { "Referer": "{base_url}" },
			"capture_patterns": ["/chapters?"],
			"on_capture": {
				"request_type": "json_request",
				"type": "placeholder",
				"base": "captured_url",
				"method": "GET",
				"headers": { "Referer": "{base_url}" }
			}
		},
		"parser": {
			"response_type": "json",
			"chapters": {
				"type": "node",
				"key": "items",
				"for_each": {
					"chapter_id": { "key": "id" },
					"chapter_number": { "type": "double", "key": "number" },
					"chapter_title": { "key": "name" },
					"chapter_uploaded_at": { "type": "date", "key": "createdAt", "format": "epochSeconds" },
					"chapter_url": {
						"type": "url",
						"key": "id",
						"headers": { "Referer": "{manga_url}" },
						"ops": [
							{
								"type": "prepend_if_missing",
								"value": "https://mangafire.to/title/{manga_id}/chapter/"
							}
						]
					}
				}
			}
		}
	},
	"pages": {
		"request": {
			"request_type": "request_capture",
			"type": "placeholder",
			"base": "chapter_url",
			"method": "GET",
			"headers": { "Referer": "{chapter_url}" },
			"capture_patterns": ["/api/chapters/"],
			"on_capture": {
				"request_type": "json_request",
				"type": "placeholder",
				"base": "captured_url",
				"method": "GET",
				"headers": { "Referer": "{base_url}" }
			}
		},
		"parser": {
			"response_type": "json",
			"pages": {
				"type": "node",
				"key": "data.pages",
				"for_each": {
					"page_url": {
						"type": "url",
						"key": "url",
						"headers": { "Referer": "{base_url}" }
					}
				}
			}
		}
	},
	"mapping": {
		"manga_status": {
			"releasing": "ongoing",
			"finished": "completed",
			"on_hiatus": "hiatus",
			"discontinued": "cancelled"
		}
	}
}
