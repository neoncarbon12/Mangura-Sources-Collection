{
	"id": "mangak",
	"name": "MangaK",
	"version": 1,
	"logo": "https://neoncarbon12.github.io/Mangura-Sources-Collection/resources/icons/mangak.png",
	"base_url": "https://mangak.io/",
	"catalog": {
		"default_parser": {
			"response_type": "json",
			"results": {
				"type": "node",
				"key": "data.items",
				"for_each": {
					"manga_id": { "key": "id" },
					"manga_title": { "key": "name" },
					"manga_cover": {
						"type": "url",
						"key": "cover",
						"headers": { "Referer": "{base_url}" }
					}
				}
			}
		},
		"trending": {
			"request": {
				"request_type": "json_request",
				"type": "absolute",
				"base": "https://api.mangak.io/titles/search",
				"method": "GET",
				"query_parameters": [
					{ "name": "sort", "value": "views" },
					{ "name": "page", "value": "{page}", "rules": ["startsAtOne"] }
				],
				"headers": { "Referer": "{base_url}" }
			}
		},
		"newest": {
			"request": {
				"request_type": "json_request",
				"type": "absolute",
				"base": "https://api.mangak.io/titles/search",
				"method": "GET",
				"query_parameters": [
					{ "name": "sort", "value": "latest" },
					{ "name": "page", "value": "{page}", "rules": ["startsAtOne"] }
				],
				"headers": { "Referer": "{base_url}" }
			}
		},
		"search": {
			"request": {
				"request_type": "json_request",
				"type": "absolute",
				"base": "https://api.mangak.io/titles/search",
				"method": "GET",
				"query_parameters": [
					{ "name": "q", "value": "{query}", "rules": ["forceNonEmpty"] },
					{ "name": "page", "value": "{page}", "rules": ["startsAtOne"] }
				],
				"headers": { "Referer": "{base_url}" }
			},
			"filters": []
		}
	},
	"details": {
		"request": {
			"request_type": "json_request",
			"type": "absolute",
			"base": "https://api.mangak.io/titles",
			"method": "GET",
			"path_parameters": [
				{ "value": "{manga_id}", "rules": ["forceNonEmpty"] }
			],
			"headers": { "Referer": "{base_url}" }
		},
		"parser": {
			"response_type": "html",
			"manga_title": {
				"expr": "body",
				"attr": "text",
				"ops": [
					{
						"type": "regex_replace",
						"pattern": "^(?:[\\s\\S]*?\"title\":\\{[^{\\[]*?\"name\":\"((?:[^\"\\\\]|\\\\.)*)\")?[\\s\\S]*$",
						"value": "$1"
					},
					{ "type": "replace", "pattern": "\\\"", "value": "\"" },
					{ "type": "trim" }
				]
			},
			"manga_description": {
				"expr": "body",
				"attr": "text",
				"ops": [
					{
						"type": "regex_replace",
						"pattern": "^(?:[\\s\\S]*?\"summary\":\"((?:[^\"\\\\]|\\\\.)*)\")?[\\s\\S]*$",
						"value": "$1"
					},
					{ "type": "replace", "pattern": "\\r", "value": "" },
					{ "type": "replace", "pattern": "\\n", "value": "\n" },
					{ "type": "replace", "pattern": "\\t", "value": " " },
					{ "type": "replace", "pattern": "\\\"", "value": "\"" },
					{ "type": "trim" }
				]
			},
			"manga_status": {
				"expr": "body",
				"attr": "text",
				"ops": [
					{
						"type": "regex_replace",
						"pattern": "^(?:[\\s\\S]*?\"status\":\"([^\"]*)\")?[\\s\\S]*$",
						"value": "$1"
					},
					{ "type": "trim" }
				]
			},
			"manga_authors": {
				"type": "list",
				"expr": "body",
				"attr": "text",
				"ops": [
					{
						"type": "regex_replace",
						"pattern": "^(?:[\\s\\S]*?\"authors\":\\[([^\\]]*)\\])?[\\s\\S]*$",
						"value": "$1"
					},
					{
						"type": "regex_replace",
						"pattern": "\\{[^}]*?\"name\":\"((?:[^\"\\\\]|\\\\.)*)\"[^}]*\\},?",
						"value": "$1|"
					},
					{ "type": "replace", "pattern": "\\\"", "value": "\"" },
					{ "type": "split", "pattern": "|" },
					{ "type": "trim" }
				]
			},
			"manga_tags": {
				"type": "list",
				"expr": "body",
				"attr": "text",
				"ops": [
					{
						"type": "regex_replace",
						"pattern": "^(?:[\\s\\S]*?\"genres\":\\[([^\\]]*)\\])?[\\s\\S]*$",
						"value": "$1"
					},
					{
						"type": "regex_replace",
						"pattern": "\\{[^}]*?\"name\":\"((?:[^\"\\\\]|\\\\.)*)\"[^}]*\\},?",
						"value": "$1|"
					},
					{ "type": "replace", "pattern": "\\\"", "value": "\"" },
					{ "type": "split", "pattern": "|" },
					{ "type": "trim" }
				]
			},
			"manga_cover": {
				"type": "url",
				"expr": "body",
				"attr": "text",
				"ops": [
					{
						"type": "regex_replace",
						"pattern": "^(?:[\\s\\S]*?\"cover\":\"([^\"]*)\")?[\\s\\S]*$",
						"value": "$1"
					}
				],
				"headers": { "Referer": "{base_url}" }
			},
			"manga_last_updated": {
				"type": "date",
				"expr": "body",
				"attr": "text",
				"ops": [
					{
						"type": "regex_replace",
						"pattern": "^(?:[\\s\\S]*?\"updated_at\":\"([^\"]*)\")?[\\s\\S]*$",
						"value": "$1"
					}
				],
				"format": "yyyy-MM-dd'T'HH:mm:ss.SSSXXXXX"
			},
			"manga_url": {
				"type": "url",
				"expr": "body",
				"attr": "text",
				"ops": [
					{
						"type": "regex_replace",
						"pattern": "^(?:[\\s\\S]*?\"title\":\\{[^{\\[]*?\"url\":\"([^\"]*)\")?[\\s\\S]*$",
						"value": "$1"
					},
					{ "type": "regex_replace", "pattern": "^/", "value": "" },
					{ "type": "prepend_if_missing", "value": "{base_url}" }
				]
			}
		}
	},
	"chapters": {
		"request": {
			"request_type": "json_request",
			"type": "absolute",
			"base": "https://api.mangak.io/titles",
			"method": "GET",
			"path_parameters": [
				{ "value": "{manga_id}", "rules": ["forceNonEmpty"] },
				{ "value": "chapters" }
			],
			"headers": { "Referer": "{base_url}" }
		},
		"parser": {
			"response_type": "json",
			"chapters": {
				"type": "node",
				"key": "data.chapters",
				"for_each": {
					"chapter_id": { "key": "id" },
					"chapter_url": {
						"type": "url",
						"key": "url",
						"ops": [
							{
								"type": "regex_replace",
								"pattern": "^/?([^/]+)/(.+)$",
								"value": "https://api.mangak.io/titles/by-slug/$1/chapters/$2"
							}
						]
					},
					"chapter_number": {
						"type": "double",
						"key": "name",
						"ops": [
							{
								"type": "regex_replace",
								"pattern": "^(?:[\\s\\S]*?[Cc]hapter\\s*(\\d+(?:\\.\\d+)?)[\\s\\S]*|\\D*(\\d+(?:\\.\\d+)?)[\\s\\S]*|[\\s\\S]*)$",
								"value": "0$1$2"
							}
						]
					},
					"chapter_title": {
						"key": "name",
						"ops": [{ "type": "trim" }]
					},
					"chapter_uploaded_at": { "type": "date", "key": "updated_at", "format": "yyyy-MM-dd'T'HH:mm:ss.SSSXXXXX" }
				}
			}
		}
	},
	"pages": {
		"request": {
			"request_type": "json_request",
			"type": "placeholder",
			"base": "chapter_url",
			"method": "GET",
			"query_parameters": [{ "name": "include", "value": "details" }],
			"headers": { "Referer": "{base_url}" }
		},
		"parser": {
			"response_type": "json",
			"pages": { "type": "list", "key": "data.chapter.images" }
		}
	},
	"mapping": {
		"manga_status": {
			"canceled": "cancelled",
			"dropped": "cancelled",
			"discontinued": "cancelled",
			"on hiatus": "hiatus"
		}
	}
}
